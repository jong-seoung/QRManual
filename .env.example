# ─── DB (PostgreSQL) ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=qrmanual
DB_USERNAME=qrmanual
DB_PASSWORD=

# Drizzle 등 외부 도구는 풀 connection string도 받음
DATABASE_URL=postgresql://qrmanual:@postgres:5432/qrmanual

# ─── Redis ────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────
# Access/Refresh 분리. 운영에서는 다른 값 사용.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# (legacy 호환) Spring 측 단일 시크릿
JWT_SECRET=

# ─── OAuth2 ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth2 콜백 URL (nginx 통합 시 같은 도메인)
OAUTH2_GOOGLE_CALLBACK=http://localhost/api/auth/oauth2/google/callback
OAUTH2_GITHUB_CALLBACK=http://localhost/api/auth/oauth2/github/callback

# ─── Mail (Gmail SMTP) ────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# (legacy 호환)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# ─── 도메인 / CORS ────────────────────────────────────────────────
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost/api
COOKIE_DOMAIN=localhost

# ─── 프론트(브라우저 노출 OK) ─────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=/api

# ─── 업로드 / 저장소 ──────────────────────────────────────────────
# STORAGE_DRIVER 미지정 시 NODE_ENV로 유추 (production → s3, else → local)
STORAGE_DRIVER=local
UPLOAD_MAX_SIZE=10485760

# Local (dev)
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8080/uploads

# S3 (prod)
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── 운영 환경 ────────────────────────────────────────────────────
NODE_ENV=development
